generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid())
  firstName    String
  lastName     String
  email        String @unique
  passwordHash String

  avatarId String? @unique
  avatar   File?   @relation("UserAvatar", fields: [avatarId], references: [id])
  phone    String?

  emailVerified              Boolean   @default(false)
  verificationToken          String?
  verificationTokenExpiresAt DateTime?
  isActive                   Boolean   @default(true)

  roles UserRole[]

  refreshTokenHash String?
  lastLoginAt      DateTime?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  candidate      Candidate?
  companyMembers CompanyMember[]
  jobs           Job[]
}

model Candidate {
  id                String           @id @default(uuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id])
  headline          String?
  bio               String?
  location          String?
  skills            String[]
  experienceLevel   ExperienceLevel?
  currentJobTitle   String?
  salaryExpectation Int?
  availability      String?
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  experiences  Experience[]
  education    Education[]
  files        File[]
}

model Company {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  website     String?
  industry    String?
  location    String?
  logoUrl     String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  companyMembers CompanyMember[]
  jobs           Job[]
}

model Job {
  id              String           @id @default(uuid())
  title           String
  description     String
  experienceLevel ExperienceLevel?
  location        String?
  salaryMin       Decimal?
  salaryMax       Decimal?
  currency        String?
  isRemote        Boolean          @default(false)
  status          JobStatus        @default(DRAFT)
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Application {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  resumeId      String?
  resume        File?     @relation("ApplicationResume", fields: [resumeId], references: [id])
  coverLetter   String?
  employerNotes String?
  reviewedAt    DateTime?

  status ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

model CompanyMember {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      CompanyRole
  joinedAt  DateTime    @default(now())

  @@unique([companyId, userId])
}

model UserRole {
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

enum Role {
  PLATFORM_ADMIN
  COMPANY_ADMIN
  RECRUITER
  CANDIDATE
}

enum ExperienceLevel {
  INTERN
  APPRENTICE
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum CompanyRole {
  COMPANY_ADMIN
  RECRUITER
  HIRING_MANAGER
  MEMBER
}

model Experience {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  jobTitle    String
  companyName String
  location    String?

  employmentType EmploymentType?

  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Education {
  id            String        @id @default(uuid())
  candidateId   String
  candidate     Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  schoolName    String
  fieldOfStudy  String?
  qualification Qualification
  startDate     DateTime
  endDate       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id          String   @id @default(uuid())
  fileName    String
  displayName String?
  mimeType    String
  size        Int
  url         String
  publicId    String
  type        FileType
  createdAt   DateTime @default(now())

  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  applicationResumes Application[] @relation("ApplicationResume")
  userAvatar         User?         @relation("UserAvatar")
}

enum FileType {
  AVATAR
  RESUME
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  APPRENTICESHIP
  FREELANCE
  VOLUNTEER
}

enum Qualification {
  PRIMARY
  SECONDARY
  HIGH_SCHOOL
  CERTIFICATE
  DIPLOMA
  ASSOCIATE
  BACHELORS
  POSTGRADUATE_DIPLOMA
  MASTERS
  DOCTORATE
}
